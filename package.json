{
  "name": "vcx",
  "version": "0.1.2",
  "description": "QoL wrapper around the Vercel CLI with multi-account and Cloudflare DNS helpers.",
  "type": "module",
  "private": true,
  "bin": {
    "vcx": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "check": "tsc --noEmit",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "bun run build && node --test test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  }
}
