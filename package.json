{
  "name": "vcx",
  "version": "0.1.3",
  "description": "Experimental Vercel CLI wrapper for local account switching and optional Cloudflare DNS updates.",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/pc-style/vcx.git"
  },
  "bin": {
    "vcx": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "check": "tsc --noEmit",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "bun run build && node --test test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  }
}
